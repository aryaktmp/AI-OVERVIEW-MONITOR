# ==============================================================================
# VARIABEL WAJIB
# ==============================================================================

# Kunci API SerpApi (hanya diakses di server, jangan beri awalan NEXT_PUBLIC_)
SERPAPI_KEY=

# Konfigurasi Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Token rahasia minimal 32 karakter untuk mengamankan endpoint /api/cron/*
CRON_SECRET=

# Hostname merek utama (tanpa http/https dan tanpa garis miring)
BRAND_DOMAIN=linovhr.com

# Batas maksimal panggilan SerpApi per jam (misal: 50 untuk Free, 200 untuk Starter)
SERPAPI_MAX_PER_HOUR=50

# Mode simulasi lokal (true = memakai fixture lokal tanpa biaya kredit SerpApi; wajib diubah ke false di produksi)
SERPAPI_DRY_RUN=true

# Daftar email yang diizinkan mengakses dasbor, dipisahkan koma tanpa spasi
ALLOWED_EMAILS=

# ==============================================================================
# VARIABEL OPSIONAL (Memiliki nilai bawaan di kode, netral terhadap platform)
# ==============================================================================

# Batas waktu maksimal pemrosesan antrean per pemanggilan HTTP dalam milidetik (nilai awal: 50000)
MAX_DURATION_MS=50000

# URL dasar aplikasi publik (opsional, digunakan oleh skrip pemeriksa kesiapan produksi & penjadwal eksternal)
APP_URL=

# URL situs untuk validasi autentikasi produksi pada check:env -- --production (opsional)
SITE_URL=

# String koneksi Postgres langsung / Session Pooler untuk pemeriksa konsistensi database (npm run verify:db, opsional & hanya baca)
DATABASE_URL=
